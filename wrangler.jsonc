{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bumpalert-web",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./www",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "bumpalert.thepixelwriter.com",
      "custom_domain": true
    }
  ]
}
